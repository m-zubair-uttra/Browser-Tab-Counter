{
  "manifest_version": 3,
  "name": "Tab Counter",
  "version": "1.0",
  "description": "Displays the total number of open tabs as a badge on the extension icon.",

  "permissions": [
    "tabs"
  ],

  "background": {
    "service_worker": "background.js"
  },

  "action": {
    "default_title": "Tab Counter"
  },

  "icons": {
    "16":  "icons/icon16.png",
    "48":  "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
